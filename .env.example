# Salin file ini menjadi .env lalu sesuaikan nilainya
# Perintah: cp .env.example .env

# Port server Express
PORT=3000

# Lokasi file database SQLite (folder dibuat otomatis)
DB_PATH=./data/mulakjabu.db

# Origin front-end yang diizinkan CORS (pisahkan dengan koma jika lebih dari satu)
CORS_ORIGIN=http://localhost:5173

# Rahasia penanda tangan token login (WAJIB diisi di produksi, minimal 16 karakter).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Jika kosong, dibuat acak tiap server start (semua sesi login berakhir saat restart).
JWT_SECRET=

# (Opsional) password akun admin saat `npm run seed`. Default: Admin12345 (hanya untuk lokal).
# SEED_ADMIN_PASSWORD=

# Isi data contoh (akun admin + homestay) otomatis saat server start DAN database masih kosong.
# Default aktif. Isi false untuk mematikan. Database yang sudah berisi tidak pernah disentuh.
# AUTO_SEED=true

# Di Railway: pasang Volume (mis. di /data) lalu isi DB_PATH=/data/mulakjabu.db
# agar data (akun, pesanan) tidak hilang saat deploy ulang.
